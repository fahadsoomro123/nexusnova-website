{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "nexusnova-support-payments",
  "main": "./worker.js",
  "compatibility_date": "2026-10-09",
  "workers_dev": true,
  "routes": [
    {
      "pattern": "nexusnovatools.com/api/support/*",
      "zone_name": "nexusnovatools.com"
    },
    {
      "pattern": "www.nexusnovatools.com/api/support/*",
      "zone_name": "nexusnovatools.com"
    }
  ],
  "vars": {
    "SUPPORT_CHECKOUT_ENABLED": "false",
    "SAFEPAY_ENV": "sandbox"
  }
}
